


<div class="content-form">
        <h3>Bir Yorum Yapın</h3>
        <form method="post">
            <input type="hidden" placeholder="ID" name="Blogid" value="@ViewBag.deger" style="border: 1px solid #000000;" required />
            <input type="text" placeholder="Kullanıcı Adı" name="KullaniciAdi" style="border: 1px solid #000000;" required />
            <input type="text" placeholder="Mail Adresi" name="Mail" style="border: 1px solid #000000;" required />
            <textarea placeholder="Yorum" name="Yorum" style="border: 1px solid #000000;"></textarea>
            <input type="submit" value="Gönder" />
        </form>
    </div>
  